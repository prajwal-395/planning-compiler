{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "AcceptanceCriterion": {
      "additionalProperties": false,
      "description": "One acceptance criterion on the objective.",
      "properties": {
        "command": {
          "description": "Command to run, for `kind = \"command\"`.",
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "default": "",
          "description": "Human-readable statement. Required for every kind.",
          "type": "string"
        },
        "kind": {
          "allOf": [
            {
              "$ref": "#/definitions/AcceptanceKind"
            }
          ],
          "description": "How the criterion is checked."
        },
        "metric": {
          "description": "Metric to compare, for `kind = \"metric\"`.",
          "type": [
            "string",
            "null"
          ]
        },
        "op": {
          "description": "Comparison operator (`<=`, `>=`, `==`), for `kind = \"metric\"`.",
          "type": [
            "string",
            "null"
          ]
        },
        "value": {
          "description": "Threshold value, for `kind = \"metric\"`.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "AcceptanceKind": {
      "description": "How an acceptance criterion is checked.",
      "oneOf": [
        {
          "description": "A person signs off.",
          "enum": [
            "manual"
          ],
          "type": "string"
        },
        {
          "description": "A command exits zero.",
          "enum": [
            "command"
          ],
          "type": "string"
        },
        {
          "description": "A metric comparison holds.",
          "enum": [
            "metric"
          ],
          "type": "string"
        }
      ]
    },
    "ArtifactDecl": {
      "additionalProperties": false,
      "description": "A declared artifact type: a name plus its typed fields.",
      "properties": {
        "fields": {
          "description": "Field names this artifact type carries.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "name": {
          "description": "Artifact type name, e.g. `\"transcript\"`.",
          "type": "string"
        }
      },
      "required": [
        "fields",
        "name"
      ],
      "type": "object"
    },
    "Capability": {
      "additionalProperties": false,
      "description": "An executor with a typed contract and three-point estimates.\n\n`kind` deliberately excludes people: there is no `human-role` in v0.",
      "properties": {
        "consumes": {
          "default": [],
          "description": "Typed inputs the capability needs from the invoking task.",
          "items": {
            "$ref": "#/definitions/ContractItem"
          },
          "type": "array"
        },
        "estimates": {
          "default": [],
          "description": "Three-point estimates per metric.",
          "items": {
            "$ref": "#/definitions/Estimate"
          },
          "type": "array"
        },
        "id": {
          "description": "Stable capability id, e.g. `\"whisperx@3\"`.",
          "type": "string"
        },
        "kind": {
          "allOf": [
            {
              "$ref": "#/definitions/CapabilityKind"
            }
          ],
          "description": "Executor flavour. People are out of scope for v0."
        },
        "licensing_constraints": {
          "default": [],
          "description": "Licences the capability is available under, as alternatives; at least one must be among `objective.licenses` when the plan declares any (E016).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "platform_requirements": {
          "default": [],
          "description": "Platforms the capability runs on, as alternatives; at least one must be among `objective.platforms` when the plan declares any (E016).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "produces": {
          "default": [],
          "description": "Typed outputs the capability delivers.",
          "items": {
            "$ref": "#/definitions/ContractItem"
          },
          "type": "array"
        },
        "provider": {
          "default": null,
          "description": "Organization or project that provides this capability.",
          "type": [
            "string",
            "null"
          ]
        },
        "resources": {
          "default": [],
          "description": "Resources this capability draws on.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "source": {
          "default": null,
          "description": "Source locator for the capability record, such as a package URL or repository.",
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "default": "",
          "description": "Capability version string.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "type": "object"
    },
    "CapabilityKind": {
      "description": "Executor flavours v0 models. No human executors.",
      "oneOf": [
        {
          "description": "A coding agent or harness.",
          "enum": [
            "agent"
          ],
          "type": "string"
        },
        {
          "description": "A deterministic tool or model endpoint.",
          "enum": [
            "tool"
          ],
          "type": "string"
        },
        {
          "description": "A composed workflow.",
          "enum": [
            "workflow"
          ],
          "type": "string"
        },
        {
          "description": "An imported skill (contracts live in a sidecar).",
          "enum": [
            "skill"
          ],
          "type": "string"
        },
        {
          "description": "An external service.",
          "enum": [
            "service"
          ],
          "type": "string"
        }
      ]
    },
    "ContractItem": {
      "additionalProperties": false,
      "description": "One typed contract entry: an artifact plus the fields used.",
      "properties": {
        "artifact": {
          "description": "Artifact type name. Must be declared under `artifact`.",
          "type": "string"
        },
        "fields": {
          "description": "Fields of that artifact. Must be a subset of the declaration.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "artifact",
        "fields"
      ],
      "type": "object"
    },
    "Estimate": {
      "additionalProperties": false,
      "description": "A three-point estimate with provenance.",
      "properties": {
        "high": {
          "description": "Pessimistic bound.",
          "format": "double",
          "type": "number"
        },
        "likely": {
          "description": "Most likely value.",
          "format": "double",
          "type": "number"
        },
        "low": {
          "description": "Optimistic bound.",
          "format": "double",
          "type": "number"
        },
        "metric": {
          "description": "One of [`KNOWN_METRICS`].",
          "type": "string"
        },
        "observations": {
          "description": "Observation count, for `measured` provenance.",
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "provenance": {
          "allOf": [
            {
              "$ref": "#/definitions/EstimateProvenance"
            }
          ],
          "description": "Where the numbers came from."
        },
        "window": {
          "description": "Evidence window label, e.g. `\"30d\"`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "high",
        "likely",
        "low",
        "metric",
        "provenance"
      ],
      "type": "object"
    },
    "EstimateProvenance": {
      "description": "Where an estimate's numbers came from.",
      "oneOf": [
        {
          "description": "A guess written by a person or agent.",
          "enum": [
            "declared"
          ],
          "type": "string"
        },
        {
          "description": "Derived from evidence (P5 estimators).",
          "enum": [
            "measured"
          ],
          "type": "string"
        }
      ]
    },
    "Evidence": {
      "additionalProperties": false,
      "description": "One append-only observation about a capability, method or task.\n\nP1/P2 check units, timestamps, values, the subject shape (see [`check_evidence_subject`]) and the typed basis (see [`check_evidence_basis`]; P2 also refuses one attributed capability and metric under two bases); P5 folds it into capability profiles (see `docs/passes.md`). A well-formed subject that names nothing in the plan is not an error: P5 holds the record as pending until the subject is proposed, so evidence can be staged together with the hypothesis it supports.",
      "properties": {
        "artifact_hash": {
          "description": "Optional content hash of the backing artifact.",
          "type": [
            "string",
            "null"
          ]
        },
        "basis": {
          "default": null,
          "description": "Typed measurement basis: what the value is measured against. `None` means no basis was recorded (all pre-basis evidence). `Some` must pass [`check_evidence_basis`].",
          "type": [
            "string",
            "null"
          ]
        },
        "metric": {
          "description": "One of [`KNOWN_METRICS`].",
          "type": "string"
        },
        "source": {
          "description": "Where the observation came from.",
          "type": "string"
        },
        "subject": {
          "description": "`capability:<id>`, `method:<id>` or `task:<id>`.",
          "type": "string"
        },
        "time": {
          "description": "RFC 3339 timestamp.",
          "type": "string"
        },
        "unit": {
          "description": "Observed unit; P1 accepts only the metric's canonical unit (case-insensitive) and canonicalizes its case.",
          "type": "string"
        },
        "value": {
          "description": "Observed value.",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "metric",
        "source",
        "subject",
        "time",
        "unit",
        "value"
      ],
      "type": "object"
    },
    "HypothesisAlternativeValue": {
      "additionalProperties": false,
      "description": "Utility for an implementation under one hypothesis.",
      "properties": {
        "alternative": {
          "description": "Method id for this task; every hypothesis in one investigation must value the same alternative set so EVSI compares like with like.",
          "type": "string"
        },
        "value": {
          "description": "Expected utility if this implementation runs and the hypothesis holds.",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "alternative",
        "value"
      ],
      "type": "object"
    },
    "Investigation": {
      "additionalProperties": false,
      "description": "Explicit investigation model for one task's implementation decision. Values are objective utility points: higher is better, and the same scale must be used for every alternative and the investigation cost.",
      "properties": {
        "cost": {
          "description": "Investigation effort expressed in the same utility points as outcomes.",
          "format": "double",
          "type": "number"
        },
        "cost_source": {
          "description": "Provenance for the investigation cost.",
          "type": "string"
        },
        "hypotheses": {
          "description": "Explicit mutually exclusive states of the world being investigated.",
          "items": {
            "$ref": "#/definitions/InvestigationHypothesis"
          },
          "type": "array"
        },
        "task": {
          "description": "Task this investigation could change.",
          "type": "string"
        }
      },
      "required": [
        "cost",
        "cost_source",
        "hypotheses",
        "task"
      ],
      "type": "object"
    },
    "InvestigationHypothesis": {
      "additionalProperties": false,
      "description": "A possible state discovered by investigation.",
      "properties": {
        "alternatives": {
          "description": "Expected utility of each available implementation if this hypothesis is true. Higher values are better.",
          "items": {
            "$ref": "#/definitions/HypothesisAlternativeValue"
          },
          "type": "array"
        },
        "id": {
          "description": "Stable hypothesis identifier.",
          "type": "string"
        },
        "probability": {
          "anyOf": [
            {
              "$ref": "#/definitions/ProbabilityEstimate"
            },
            {
              "type": "null"
            }
          ],
          "description": "Probability bounds. Missing bounds mean probability is unknown."
        },
        "source": {
          "description": "Provenance for the hypothesis and its probability estimate.",
          "type": "string"
        }
      },
      "required": [
        "alternatives",
        "id",
        "source"
      ],
      "type": "object"
    },
    "Method": {
      "additionalProperties": false,
      "description": "One way to achieve a task.\n\n`kind` selects the shape: `decompose` uses `subtasks`/`order_edges`, `invoke` uses `capability`. P2 reports E013 when the shape is mixed.",
      "properties": {
        "assumptions": {
          "default": [],
          "description": "Assumptions `explain` must surface (step 2).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "capability": {
          "description": "Capability id, for `kind = \"invoke\"`.",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "description": "Stable method id, unique among methods.",
          "type": "string"
        },
        "kind": {
          "allOf": [
            {
              "$ref": "#/definitions/MethodKind"
            }
          ],
          "description": "Decomposition versus capability invocation."
        },
        "order_edges": {
          "default": [],
          "description": "Ordering constraints between subtasks, for `kind = \"decompose\"`.",
          "items": {
            "$ref": "#/definitions/OrderEdge"
          },
          "type": "array"
        },
        "provenance": {
          "default": "",
          "description": "Who proposed it: `human:<name>`, `agent:<name>`, `llm:<model>`, or `pass:<name>`.",
          "type": "string"
        },
        "status": {
          "allOf": [
            {
              "$ref": "#/definitions/MethodStatus"
            }
          ],
          "description": "Lifecycle: `accepted`/`derived` methods are checked; only `accepted` methods are compiled."
        },
        "subtasks": {
          "default": [],
          "description": "Child task ids, for `kind = \"decompose\"`.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "task": {
          "description": "Task this method achieves.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "status",
        "task"
      ],
      "type": "object"
    },
    "MethodKind": {
      "description": "Decomposition versus invocation.",
      "oneOf": [
        {
          "description": "Achieve the task via subtasks.",
          "enum": [
            "decompose"
          ],
          "type": "string"
        },
        {
          "description": "Achieve the task via a capability.",
          "enum": [
            "invoke"
          ],
          "type": "string"
        }
      ]
    },
    "MethodStatus": {
      "description": "Lifecycle of a method. P2 checks `accepted` and `derived` only.",
      "oneOf": [
        {
          "description": "Committed to the plan.",
          "enum": [
            "accepted"
          ],
          "type": "string"
        },
        {
          "description": "Awaiting `accept`/`reject` (step 7).",
          "enum": [
            "proposed"
          ],
          "type": "string"
        },
        {
          "description": "Generated by a compiler pass.",
          "enum": [
            "derived"
          ],
          "type": "string"
        },
        {
          "description": "Explicitly refused; ignored by every pass.",
          "enum": [
            "rejected"
          ],
          "type": "string"
        }
      ]
    },
    "Objective": {
      "additionalProperties": false,
      "description": "Root task plus constraints, weights and acceptance criteria.",
      "properties": {
        "acceptance": {
          "default": [],
          "description": "What counts as achieving the objective.",
          "items": {
            "$ref": "#/definitions/AcceptanceCriterion"
          },
          "type": "array"
        },
        "budget_usd": {
          "description": "Hard budget in USD, if any.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "deadline": {
          "description": "Hard deadline (free-form date string in v0), if any.",
          "type": [
            "string",
            "null"
          ]
        },
        "licenses": {
          "default": [],
          "description": "Licences the plan accepts. When non-empty, every non-rejected invoke's capability must list one of these in `licensing_constraints` when it lists any (E016).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "platforms": {
          "default": [],
          "description": "Platforms the plan runs on. When non-empty, every non-rejected invoke's capability must list one of these in `platform_requirements` when it lists any (E016).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "quality_floor": {
          "description": "Hard quality floor in `[0, 1]`, if any.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "root_task": {
          "description": "Id of the root task.",
          "type": "string"
        },
        "weights": {
          "additionalProperties": {
            "format": "double",
            "type": "number"
          },
          "default": {},
          "description": "Weight per metric for the step-3 additive objective. v0 only validates.",
          "type": "object"
        }
      },
      "required": [
        "root_task"
      ],
      "type": "object"
    },
    "OrderEdge": {
      "additionalProperties": false,
      "description": "An ordering constraint `from` -> `to` between subtasks of one method.",
      "properties": {
        "from": {
          "description": "Predecessor subtask id.",
          "type": "string"
        },
        "to": {
          "description": "Successor subtask id.",
          "type": "string"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "type": "object"
    },
    "PlanMeta": {
      "additionalProperties": false,
      "description": "Plan identity and the fields an external input may satisfy.",
      "properties": {
        "description": {
          "default": "",
          "description": "Longer description, if any.",
          "type": "string"
        },
        "external_inputs": {
          "default": [],
          "description": "Artifact fields the world provides, so dataflow need not produce them.",
          "items": {
            "$ref": "#/definitions/ContractItem"
          },
          "type": "array"
        },
        "id": {
          "description": "Stable plan id, e.g. `\"self-plan\"`.",
          "type": "string"
        },
        "tasks_axi_sections": {
          "default": [],
          "description": "tasks-axi section names in file order, preserved so export restores sections even when they hold no items. Empty for plans that did not come from an import; every pass ignores it.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "title": {
          "description": "Human title.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title"
      ],
      "type": "object"
    },
    "ProbabilityEstimate": {
      "additionalProperties": false,
      "description": "A probability estimate with explicit source and optional measured sample count. Bounds are used directly; no midpoint is fabricated by the compiler.",
      "properties": {
        "high": {
          "description": "Upper probability bound in `[0, 1]`, at least `low`.",
          "format": "double",
          "type": "number"
        },
        "low": {
          "description": "Lower probability bound in `[0, 1]`.",
          "format": "double",
          "type": "number"
        },
        "observations": {
          "description": "Measured sample count behind the bounds, when known.",
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "provenance": {
          "allOf": [
            {
              "$ref": "#/definitions/EstimateProvenance"
            }
          ],
          "description": "Where the bounds came from."
        },
        "source": {
          "description": "Provenance for the bounds (measurement, calibration run, reviewer).",
          "type": "string"
        }
      },
      "required": [
        "high",
        "low",
        "provenance",
        "source"
      ],
      "type": "object"
    },
    "ResourceDecl": {
      "additionalProperties": false,
      "description": "A named capacity, e.g. `\"gpu-1\"`. v0 reports usage only.",
      "properties": {
        "capacity": {
          "description": "Available capacity in `unit`.",
          "format": "double",
          "type": "number"
        },
        "name": {
          "description": "Resource name.",
          "type": "string"
        },
        "unit": {
          "default": "",
          "description": "Capacity unit, free-form in v0.",
          "type": "string"
        }
      },
      "required": [
        "capacity",
        "name"
      ],
      "type": "object"
    },
    "Task": {
      "additionalProperties": false,
      "description": "A need: what must be true or produced.",
      "properties": {
        "beads_jsonl": {
          "default": null,
          "description": "Original Beads issue JSONL record, preserved verbatim for lossless export. Its presence also keeps this imported issue distinct under P4 sharing.",
          "type": [
            "string",
            "null"
          ]
        },
        "consumes": {
          "default": [],
          "description": "Typed inputs this task needs from upstream or external inputs.",
          "items": {
            "$ref": "#/definitions/ContractItem"
          },
          "type": "array"
        },
        "id": {
          "description": "Stable task id.",
          "type": "string"
        },
        "produces": {
          "default": [],
          "description": "Typed outputs this task promises downstream.",
          "items": {
            "$ref": "#/definitions/ContractItem"
          },
          "type": "array"
        },
        "state": {
          "allOf": [
            {
              "$ref": "#/definitions/TaskState"
            }
          ],
          "description": "Lifecycle state. The compiler reads `done`, never sets it."
        },
        "tasks_axi": {
          "anyOf": [
            {
              "$ref": "#/definitions/TasksAxiMeta"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "tasks-axi `backlog.md` passthrough: fields with no IR counterpart (section, repo, kind, priority, holds, date gates, body). No pass reads its values, so a backlog round-trips byte-identical instead of being refused or dropped. `None` for tasks that did not come from an import."
        },
        "title": {
          "description": "Human title.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "state",
        "title"
      ],
      "type": "object"
    },
    "TaskState": {
      "description": "Lifecycle states for a task.",
      "oneOf": [
        {
          "description": "Not yet broken down.",
          "enum": [
            "open"
          ],
          "type": "string"
        },
        {
          "description": "Has an accepted decomposition.",
          "enum": [
            "decomposed"
          ],
          "type": "string"
        },
        {
          "description": "Fully reduced to invocations (informational in v0).",
          "enum": [
            "resolved"
          ],
          "type": "string"
        },
        {
          "description": "Observed finished. Read from imports, never set by the compiler.",
          "enum": [
            "done"
          ],
          "type": "string"
        },
        {
          "description": "Explicitly abandoned.",
          "enum": [
            "dropped"
          ],
          "type": "string"
        }
      ]
    },
    "TasksAxiMeta": {
      "additionalProperties": false,
      "description": "Opaque tasks-axi `backlog.md` metadata carried through the IR.\n\nThe compiler never reads these fields; P4 only keys on their presence, so every backlog row stays distinct work. The `pc-adapter-tasks-axi` import/export pair maps them to and from the canonical backlog line (`(repo: R)`, `(kind: K)`, `(priority: N)`, `(since D)`, the closed date, `(hold: H)`, `(hold-kind: K)`, `(hold-until: D)`, section and body) so unmappable fields survive untouched.",
      "properties": {
        "body": {
          "default": null,
          "description": "Indented body text with `\\n` line breaks, without trailing newline.",
          "type": [
            "string",
            "null"
          ]
        },
        "closed": {
          "default": null,
          "description": "Closed date (`YYYY-MM-DD`), when present. Export labels it from the title: `(merged D)` for a PR link, `(reported D)` for a report path, `(done D)` otherwise.",
          "type": [
            "string",
            "null"
